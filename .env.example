# Plantilla de Variables de Entorno - Clic-Tools
# Copia este archivo a .env y completa los valores correspondientes.

# Clave secreta para tokens de sesión JWT (Generar con: openssl rand -hex 32)
SESSION_SECRET=genera_aqui_tu_secreto_hex_de_64_caracteres_minimo

# Google Gemini AI API Key
GEMINI_API_KEY=

# Base de Datos SQL Server (Opcional - Puede configurarse desde el panel de administración)
SQL_SERVER_USER=
SQL_SERVER_PASSWORD=
SQL_SERVER_HOST=
SQL_SERVER_DATABASE=
SQL_SERVER_PORT=1433
